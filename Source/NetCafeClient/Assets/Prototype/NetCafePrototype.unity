MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1366431071}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>1  \u5728\u5BA2\u5385\u91CC</b>\nWASD \u8D70\u52A8\uFF0CShift \u52A0\u5FEB\u3002\u7528\u9F20\u6807\u770B\u5411\u5750\u57AB\uFF0C\u51FA\u73B0\u63D0\u793A\u540E\u6309 E \u5750\u4E0B\u3002Esc \u6253\u5F00\u83DC\u5355\u3002\n\n<b>2  \u4F7F\u7528\u81EA\u5DF1\u7684\u7535\u8111</b>\n\u5750\u4E0B\u540E\u81EA\u52A8\u663E\u793A\u672C\u673A\u684C\u9762\u3002\u952E\u76D8\u548C\u9F20\u6807\u4EA4\u7ED9\u771F\u5B9E\u5E94\u7528\uFF1BEsc\u3001Alt\u3001F9 \u7B49\u7167\u5E38\u4F7F\u7528\u3002\u53EA\u6709\u8BBE\u7F6E\u7684\u8FD4\u56DE\u952E\u7531\u7F51\u5427\u4FDD\u7559\u3002\n\n<b>3  \u770B\u623F\u95F4\u4E0E\u79BB\u5EA7</b>\n\u6D6E\u7A97\u70B9\u201C\u770B\u623F\u95F4\u201D\uFF0C\u6309\u4F4F\u9F20\u6807\u53F3\u952E\u73AF\u987E\uFF0C\u677E\u5F00\u5373\u53EF\u64CD\u4F5C\u6D6E\u7A97\u3002\u70B9\u201C\u56DE\u5230\u7535\u8111\u201D\u7EE7\u7EED\u4F7F\u7528\uFF1BE \u6216\u201C\u79BB\u5F00\u5EA7\u4F4D\u201D\u8D77\u8EAB\u3002\u684C\u9762\u64CD\u4F5C\u671F\u95F4 E \u662F\u5E94\u7528\u6309\u952E\uFF0C\u4E0D\u4F1A\u8BA9\u4F60\u79BB\u5EA7\u3002\n\n<b>4  \u4E0D\u7528\u8BB0\u5F88\u591A\u5FEB\u6377\u952E</b>\n\u6D6E\u7A97\u53EF\u62D6\u52A8\uFF0C\u7A7A\u95F2\u7EA6 2 \u79D2\u540E\u8D34\u8FB9\u6536\u8D77\uFF1B\u628A\u9F20\u6807\u79FB\u5230\u201C\u5DE5\u5177\u201D\u6807\u7B7E\u4E0A\u5C55\u5F00\u3002\u83DC\u5355\u4E2D\u4E5F\u80FD\u770B\u623F\u95F4\u3001\u79BB\u5EA7\u548C\u9000\u51FA\u3002\n\n<b>5  \u663E\u793A\u4E0E\u8BBE\u7F6E</b>\n\u201C\u5207\u6362\u5168\u5C4F\u201D\u5728\u7EA6 90% \u5C4F\u5E55\u4E0E\u5B8C\u5168\u5168\u5C4F\u4E4B\u95F4\u5207\u6362\u3002\u83DC\u5355 \u2192 \u8BBE\u7F6E\uFF0C\u53EF\u66F4\u6539\u8FD4\u56DE\u952E\u3001\u6587\u5B57\u5927\u5C0F\u3001\u663E\u793A\u5668\u548C\u706F\u5149\u3002\u66F4\u6362\u663E\u793A\u5668\u524D\u5148\u505C\u6B62\u9884\u89C8\u3002\u4E3B\u83DC\u5355\u5E95\u90E8\u53EF\u628A\u5F53\u524D Unity \u753B\u9762\u4FDD\u5B58\u4E3A PNG\uFF1B\u622A\u56FE\u53EA\u5199\u5230\u672C\u673A\uFF0C\u4E0D\u4F1A\u4E0A\u4F20\u6216\u5171\u4EAB\u3002\n\n<b>6  \u56DE\u5230 Windows \u6216\u9000\u51FA</b>\nWindows \u952E\u6216 Alt+Tab \u4F1A\u91CA\u653E\u63A7\u5236\u5E76\u6062\u590D\u7CFB\u7EDF\u5149\u6807\u3002\u8FD4\u56DE\u6E38\u620F\u540E\u70B9\u201C\u7EE7\u7EED\u201D\u3002\u9000\u51FA\u7F51\u5427\u8BF7\u7528\u83DC\u5355\u4E2D\u7684\u201C\u9000\u51FA\u7F51\u5427\u201D\uFF1B\u64CD\u4F5C\u7535\u8111\u65F6 Alt+F4 \u4F1A\u5173\u95ED\u5F53\u524D\u771F\u5B9E\u5E94\u7528\u3002\n\n<b>7  \u83DC\u5355\u5BFC\u822A</b>\n\u9F20\u6807\u70B9\u51FB\uFF0C\u6216 Tab / Shift+Tab\u3001\u65B9\u5411\u952E\u9009\u62E9\uFF0CEnter \u786E\u8BA4\uFF0CEsc \u8FD4\u56DE\u4E0A\u4E00\u7EA7\u3002\u624B\u67C4\u53EF\u7528\u65B9\u5411\u952E\uFF0F\u6447\u6746\u3001A \u786E\u8BA4\u3001B \u8FD4\u56DE\u3002\n\n<b>\u5F53\u524D\u8303\u56F4</b>\n\u5355\u4EBA\u6A21\u5F0F\u59CB\u7EC8\u53EA\u4F7F\u7528\u81EA\u5DF1\u7684\u684C\u9762\uFF1B\u8054\u7F51\u623F\u95F4\u9700\u8981 B1 \u6784\u5EFA\u4E0E\u5F00\u623F\u670D\u52A1\u3002\u8BED\u97F3\u4E0E\u7F51\u7EDC\u684C\u9762\u5171\u4EAB\u5C1A\u672A\u5728\u6B64\u7248\u542F\u7528\uFF0C\u4E0D\u4F1A\u56E0\u4E3A\u8FDB\u5165\u623F\u95F4\u81EA\u52A8\u53D1\u5E03\u3002"
